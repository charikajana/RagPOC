# ─────────────────────────────────────────────────────────────────────────────
# ADD THESE LINES to your existing Automation Framework's .env file
# ─────────────────────────────────────────────────────────────────────────────

# Path to the RagPOC project folder (where you cloned it)
RAG_POC_PATH=C:\Chari_Local\AzureDevOps\RagPOC

# RAG Engine API URL (default: localhost:3001)
RAG_ENGINE_URL=http://localhost:3001

# Where RAG should write generated .feature files (relative to your framework root)
# Change these to match YOUR framework's actual folder paths
RAG_FEATURES_OUT=./features
RAG_STEPS_OUT=./steps
