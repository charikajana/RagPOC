# RAG Engine Environment Configuration
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# ANTHROPIC (Claude API)  ← PRIMARY LLM
# ─────────────────────────────────────────────
# Sign up FREE at: https://console.anthropic.com
# You get $5 free credits on sign-up (enough for 100s of test generations)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model options (uncomment the one you want):
#   claude-3-5-haiku-20241022   ← fastest & cheapest  (recommended for POC)
#   claude-3-5-sonnet-20241022  ← best quality output
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ─────────────────────────────────────────────
# OLLAMA (Local Embeddings)  ← FREE, no API key
# ─────────────────────────────────────────────
# Setup (one-time):
#   1. Install Ollama: https://ollama.com/download
#   2. Run in terminal: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─────────────────────────────────────────────
# AZURE DEVOPS
# ─────────────────────────────────────────────
# PAT needs: Work Items → Read
ADO_ORGANIZATION=your-org-name
ADO_PROJECT=your-project-name
ADO_PAT=your_personal_access_token_here

# ─────────────────────────────────────────────
# VECTOR DATABASE (CHROMADB)
# ─────────────────────────────────────────────
# Start with: docker compose up chromadb -d
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=rag_test_automation

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─────────────────────────────────────────────
# KNOWLEDGE BASE PATHS
# ─────────────────────────────────────────────
FEATURES_PATH=./knowledge/features
STEPS_PATH=./knowledge/steps
DOCS_PATH=./knowledge/docs
