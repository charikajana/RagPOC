# RAG Engine Environment Configuration
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# LLM PROVIDER  ← CHOOSE ONE
# Options: github | anthropic | azure
# ─────────────────────────────────────────────
LLM_PROVIDER=github

# ─────────────────────────────────────────────
# OPTION 1: GITHUB MODELS ← FREE with your Copilot subscription
# Uses the same GPT-4o that powers GitHub Copilot
# Get token: https://github.com/settings/tokens  (any classic PAT)
# ─────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_pat_here
GITHUB_MODEL=gpt-4o
# Model options: gpt-4o | gpt-4o-mini | phi-3-medium

# ─────────────────────────────────────────────
# OPTION 2: ANTHROPIC (Claude) ← comment out if using GitHub
# ─────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ─────────────────────────────────────────────
# OPTION 3: AZURE OPENAI ← comment out if using GitHub
# ─────────────────────────────────────────────
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-02-01

# ─────────────────────────────────────────────
# OLLAMA (Local Embeddings)  ← FREE, no API key
# ─────────────────────────────────────────────
# Setup (one-time):
#   1. Install Ollama: https://ollama.com/download
#   2. Run in terminal: ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─────────────────────────────────────────────
# AZURE DEVOPS
# ─────────────────────────────────────────────
# PAT needs: Work Items → Read
ADO_ORGANIZATION=your-org-name
ADO_PROJECT=your-project-name
ADO_PAT=your_personal_access_token_here

# ─────────────────────────────────────────────
# VECTOR DATABASE (CHROMADB)
# ─────────────────────────────────────────────
# Start with: docker compose up chromadb -d
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=rag_test_automation

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─────────────────────────────────────────────
# KNOWLEDGE BASE PATHS
# ─────────────────────────────────────────────
FEATURES_PATH=./knowledge/features
STEPS_PATH=./knowledge/steps
DOCS_PATH=./knowledge/docs
